N8N_LEAD_WEBHOOK_URL=https://n8n.omnisaas.com.br/prd/receber-lead

# Webhook dedicado ao RH: recebe multipart/form-data com o arquivo curriculo.
N8N_CAREER_WEBHOOK_URL=

# Opcional: destino dos cadastros de investidores; sem fallback de staging.
N8N_INVESTOR_WEBHOOK_URL=

# Arquivo SQLite local. No Docker, o caminho é /app/data/daytrade.sqlite.
DATABASE_FILE=./data/daytrade.sqlite
UPLOAD_DIR=./data/private

# Instagram profissional: somente servidor, nunca usar NEXT_PUBLIC_ para o token.
INSTAGRAM_USERNAME=daytradesa
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_VERSION=v27.0
