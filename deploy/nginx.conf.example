# Instale este bloco no virtual host HTTPS já configurado para o seu domínio.
# Troque daytrade.example.com pelo domínio real. Configure certificado TLS no host.
server {
    listen 443 ssl;
    server_name daytrade.example.com;
    ssl_certificate /etc/letsencrypt/live/daytrade.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/daytrade.example.com/privkey.pem;
    client_max_body_size 6m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}

server {
    listen 80;
    server_name daytrade.example.com;
    return 301 https://$host$request_uri;
}
